# Cognee (agent memory) settings for Arthai Health.
# Copy to .env and fill LLM_API_KEY. Never commit .env.
# Synthetic data only. Never put real PHI into cognee.

# Turn off cognee usage reporting (anonymous telemetry to prometh.ai).
TELEMETRY_DISABLED=1

# LLM: Muse Spark Open on Baseten (OpenAI-compatible endpoint).
LLM_PROVIDER=custom
LLM_MODEL=openai/meta-models/muse-spark-open-1026
LLM_ENDPOINT=https://inference.baseten.co/v1
LLM_API_KEY=

# Embeddings: local fastembed on CPU (no API key, no data leaves the box).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Storage: keep all cognee data inside the repo (git-ignored).
DATA_ROOT_DIRECTORY=./.cognee_data
SYSTEM_ROOT_DIRECTORY=./.cognee_system
COGNEE_LOGS_DIR=./.cognee_system/logs

# Keep local model downloads inside the repo too.
HF_HOME=./.cognee_system/huggingface

# Per-turn feedback analysis is an LLM call. Keep it off until the key is set.
AUTO_FEEDBACK=false

# Stop litellm from fetching its model price list from raw.githubusercontent.com.
LITELLM_LOCAL_MODEL_COST_MAP=True
