{
  "concurrency": 2,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "squash",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low":    { "builder": "sonnet", "code": "sonnet", "security": "sonnet" },
    "medium": { "builder": "sonnet", "code": "sonnet", "security": "sonnet" },
    "high":   { "builder": "opus",   "code": "sonnet", "security": "opus" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "sonnet" },
    "security": { "security": "opus" }
  },
  "escalate_paths": [
    "*phi*", "*patient*", "*member*", "*eligibility*", "*fhir*", "*hl7*", "*x12*", "*837*", "*835*",
    "*auth*", "*login*", "*session*", "*token*", "*secret*", "*crypt*", "*.env*",
    "*payer*", "*insurer*", "*voice*", "*call*", "*twilio*", "*telephony*",
    "*deploy*", "Dockerfile*", "*docker-compose*", "*modal*", "*fly.toml", "*vercel*", "infra/*", "terraform/*",
    ".github/*", "Makefile", "factory/*", ".claude/*", "AGENTS.md", "CLAUDE.md",
    "data/*", "scripts/*",
    "*requirements*.txt", "pyproject.toml", "*lock*", "package.json"
  ],
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    "tests/*",
    "*/tests/*",
    "*.test.ts",
    "*.test.tsx",
    "evals/*"
  ],
  "ports": { "base": 5100, "step": 10 },
  "prices_usd_per_mtok": {
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
