{
  "permissions": {
    "allow": [
      "Bash(make lint)", "Bash(make test)", "Bash(make eval)", "Bash(make e2e)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)",
      "Bash(git push:*)", "Bash(curl:*)", "Bash(psql:*prod*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [ { "type": "command", "command": "make fmt >/dev/null 2>&1 || true" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "python3 scripts/hooks/decision_reminder.py" } ] }
    ]
  }
}
